# 目前部署的 e4b 模型服務（摘要對齊啟用時使用；分類設定缺少時作為備援）
VLLM_BASE_URL=http://192.168.0.91:8003
VLLM_MODEL=gemma-4-e4b
VLLM_TIMEOUT_SECONDS=600
VLLM_TEMPERATURE=0
# 保留設定；目前摘要對齊使用 SUMMARY_ALIGN_MAX_TOKENS
VLLM_MAX_TOKENS=256

# 分類專用模型（Gemma 4 E4B）：標籤分類
CLASSIFY_BASE_URL=http://192.168.0.91:8003
CLASSIFY_MODEL=gemma-4-e4b
CLASSIFY_MAX_TOKENS=64

# 摘要對齊目前預設停用；需要時設為 true 並提供可用的主模型服務
SUMMARY_ALIGN_ENABLED=false
# 分類結果固定後，對齊中文摘要所用的主模型輸出上限
SUMMARY_ALIGN_MAX_TOKENS=384

# 爬蟲設定
SCRAPE_DELAY_SECONDS=0.8
CLASSIFY_DELAY_SECONDS=3.5
REQUEST_TIMEOUT_SECONDS=7

# 稽核檔案留存
AUDIT_ARCHIVE_DIR=audit
AUDIT_RETENTION_DAYS=30
